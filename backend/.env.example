# Backend — copy to `.env`, never commit real secrets.
DATABASE_URL=sqlite:///./nest.db
# Production PostgreSQL example (pure-python driver, no build tools needed):
# DATABASE_URL=postgresql+pg8000://nest:nest-secret@localhost:5432/nest
SECRET_KEY=change-me-to-a-long-random-secret-min-32-chars
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
BUSINESS_TIMEZONE_DEFAULT=Asia/Kolkata
WHATSAPP_PROVIDER=log
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_ENABLED=false
SEED_DEMO_PASSWORD=Nest@123
# Public website intake (server-side tenant resolution; browser businessId ignored).
PUBLIC_NEST_BUSINESS_ID=nest-library-001
PUBLIC_PRIME_BUSINESS_ID=prime-fitness-001
PUBLIC_RATE_LIMIT=10
PUBLIC_RATE_WINDOW_S=600
PUBLIC_MAX_BODY_BYTES=16384
